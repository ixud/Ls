function render(){
  if(!S) return;
  if(TAB === 'pstack' && MS) collectMS();
  const titles = { dash:'ภาพรวม', lock:'ล็อก & โมเดล', server:'Server & Cline', pstack:'pStack', bazer:'Bazer Mode', buddha:'Buddha Mode', arena:'Arena Mode', snack:'Snack', projects:'โปรเจกต์', plannotator:'Plannotator', tui:'ตั้งค่า OpenCode', history:'ประวัติ & สำรอง' };
  const af = TAB.indexOf('agent:') === 0 ? TAB.slice(6) : null;
  const meta = af ? (AGENT_META[af] || { name: af.replace(/\.md$/, '') }) : null;
  document.getElementById('hTitle').textContent = af ? (meta.name + (meta.sub ? ' (subagent)' : ' Mode')) : (titles[TAB] || '');
  const pill = document.getElementById('serverLed');
  const ptext = document.getElementById('serverPillText');
  if(S.server.up){ pill.className = 'led ok'; ptext.textContent = `server 4096 · v${S.server.version||'?'}`; }
  else { pill.className = 'led fail'; ptext.textContent = 'server 4096 ปิดอยู่'; }
  const v = af ? vAgent(af) : ({ dash: vDash, lock: vLock, server: vServer, pstack: vPstack, bazer: vBazer, buddha: vBuddha, arena: vArena, snack: vSnack, projects: vProjects, plannotator: vPl, tui: vTui, history: vHist }[TAB] || vDash)();
  document.getElementById('view').innerHTML = v;
  document.querySelectorAll('#nav > button').forEach(b => b.classList.toggle('on', b.dataset.tab === TAB));
  renderNavModes();
  renderNavSub();
  if(TAB === 'pstack'){ if(!MS) initMS(); renderMS(); }
  if(TAB === 'buddha' || TAB === 'arena'){ if(!ROLES) parseRoles(); renderRoleChips(); }
  if(TAB === 'tui') mountTui();
  setVerifyBadge();
}

