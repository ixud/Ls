<!doctype html>
<html lang="th">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>BAZER Console</title>
<link rel="icon" href="data:image/svg+xml;base64,PHN2ZyB4bWxucz0naHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmcnIHZpZXdCb3g9JzAgMCA2NCA2NCc+PHJlY3Qgd2lkdGg9JzY0JyBoZWlnaHQ9JzY0JyByeD0nMTQnIGZpbGw9JyNmNWM1NDInLz48cGF0aCBkPSdNMzIgOCBMNTIuNzggMjAgTDUyLjc4IDQ0IEwzMiA1NiBMMTEuMjIgNDQgTDExLjIyIDIwIFonIGZpbGw9JyMwYTBjMTAnLz48L3N2Zz4="/>
<style>
:root{
  --bg:#0a0c10; --panel:rgba(255,255,255,.032); --panel2:rgba(255,255,255,.055);
  --line:rgba(255,255,255,.08); --text:#e8ecf4; --dim:#8b94a7; --dim2:#5d6678;
  --gold:#f5c542; --teal:#4cc9a4; --red:#ff5c5c; --ok:#3ddc84; --warn:#ffb020;
  --radius:14px;
}
*{box-sizing:border-box}
html,body{height:100%}
body{
  margin:0;background:
    radial-gradient(1200px 600px at 80% -10%, rgba(245,197,66,.07), transparent 60%),
    radial-gradient(900px 500px at -10% 110%, rgba(76,201,164,.06), transparent 60%),
    var(--bg);
  color:var(--text);font:14px/1.55 "Segoe UI","Leelawadee UI",system-ui,sans-serif;
}
.app{display:flex;min-height:100vh}
aside{
  width:224px;flex:none;padding:18px 14px;position:sticky;top:0;height:100vh;
  display:flex;flex-direction:column;gap:14px;
  background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(255,255,255,0) 40%);
  border-right:1px solid var(--line);
}
.brand{display:flex;gap:10px;align-items:center;padding:4px 6px 12px;border-bottom:1px solid var(--line)}
.brand .logo{
  width:34px;height:34px;border-radius:10px;display:grid;place-items:center;font-size:18px;color:#0a0c10;
  background:linear-gradient(135deg,var(--gold),#ffdf7e);box-shadow:0 0 18px rgba(245,197,66,.35);
}
.brand b{display:block;font-size:15px;letter-spacing:.3px}
.brand i{display:block;font-style:normal;font-size:11px;color:var(--dim);letter-spacing:2px;text-transform:uppercase}
nav{display:flex;flex-direction:column;gap:4px;flex:1}
nav button{
  all:unset;cursor:pointer;padding:9px 12px;border-radius:10px;color:var(--dim);font-size:13.5px;
  border:1px solid transparent;transition:all .15s ease;position:relative;
}
nav button:hover{color:var(--text);background:var(--panel)}
nav button.on{
  color:var(--text);background:var(--panel2);border-color:var(--line);
  box-shadow:0 0 0 1px rgba(245,197,66,.25), 0 6px 20px -12px rgba(245,197,66,.5);
}
nav button.on::before{content:"";position:absolute;left:-1px;top:8px;bottom:8px;width:3px;border-radius:3px;background:linear-gradient(180deg,var(--gold),#ffdf7e)}
nav button.navbazer{color:#ff9a76}
nav button.navbazer:hover{color:#ffc9b5}
nav button.navbazer.on{box-shadow:0 0 0 1px rgba(217,72,15,.45), 0 6px 20px -12px rgba(217,72,15,.85)}
nav button.navbazer.on::before{background:linear-gradient(180deg,#D9480F,#ff9a76)}
nav button.navsnack{color:#7fe8dc}
nav button.navsnack:hover{color:#b3f4ec}
nav button.navsnack.on{box-shadow:0 0 0 1px rgba(64,224,208,.45), 0 6px 20px -12px rgba(64,224,208,.85)}
nav button.navsnack.on::before{background:linear-gradient(180deg,#40E0D0,#7fe8dc)}
.navgroup{font-size:10.5px;color:var(--dim);letter-spacing:.8px;text-transform:uppercase;padding:9px 12px 2px;display:flex;justify-content:space-between;align-items:center;gap:6px}
.navgroup .cnt{font-size:10.5px;letter-spacing:0;color:var(--dim2);text-transform:none}
#navModes{display:flex;flex-direction:column;gap:4px}
nav button.agent-tab{display:flex;align-items:center;gap:8px}
nav button.agent-tab .adot{width:8px;height:8px;border-radius:50%;flex:none;background:var(--dim2)}
nav button.agent-tab .aname{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
nav button.agent-tab .abadge{font-size:10px;padding:1px 7px;border-radius:999px;border:1px solid var(--line);color:var(--dim);flex:none}
nav button.agent-tab .awarn{color:var(--warn);border-color:rgba(255,176,32,.4)}
nav button.agent-tab.off{opacity:.45}
nav button.agent-tab.off .aname{text-decoration:line-through}
nav button.agent-tab.miss{opacity:.55}
nav button.agent-tab.miss .aname{font-style:italic}
.foot{display:flex;flex-direction:column;gap:8px}
.pill{
  display:flex;gap:8px;align-items:center;padding:8px 12px;border:1px solid var(--line);
  border-radius:999px;font-size:12.5px;color:var(--dim);background:var(--panel);
}
main{flex:1;min-width:0;padding:22px 26px 60px}
header{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}
header h1{font-size:19px;margin:0;letter-spacing:.2px}
.hacts{display:flex;gap:8px}
.btn{
  all:unset;cursor:pointer;border-radius:10px;padding:8px 14px;font-size:13px;text-align:center;
  border:1px solid var(--line);color:var(--text);background:var(--panel2);transition:all .15s ease;
}
.btn:hover{background:rgba(255,255,255,.09);transform:translateY(-1px)}
.btn.gold{background:linear-gradient(135deg,var(--gold),#ffdf7e);color:#14100a;font-weight:600;border-color:transparent;box-shadow:0 6px 22px -10px rgba(245,197,66,.7)}
.btn.gold:hover{filter:brightness(1.05)}
.btn.ghost{background:transparent}
.btn.danger{border-color:rgba(255,92,92,.4);color:#ffb3b3}
.btn.sm{padding:4px 10px;font-size:12px;border-radius:8px}
.view{display:flex;flex-direction:column;gap:14px;animation:fade .18s ease}
@keyframes fade{from{opacity:0;transform:translateY(3px)}to{opacity:1}}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:12px}
.card{
  background:linear-gradient(160deg,rgba(255,255,255,.05),rgba(255,255,255,.015) 45%),var(--panel);
  border:1px solid var(--line);border-radius:var(--radius);padding:14px 16px;
  backdrop-filter:blur(8px);
}
.card h3{margin:0 0 10px;font-size:13px;color:var(--dim);font-weight:600;letter-spacing:.4px;text-transform:uppercase}
.card .big{font-size:17px;font-weight:600;letter-spacing:.2px}
.card .sub{font-size:12.5px;color:var(--dim);margin-top:3px}
.row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.spread{display:flex;align-items:center;justify-content:space-between;gap:10px}
.mt{margin-top:10px}
.led{width:9px;height:9px;border-radius:50%;flex:none;background:var(--dim2);display:inline-block}
.led.ok{background:var(--ok);box-shadow:0 0 10px rgba(61,220,132,.8);animation:pulse 2.4s infinite}
.led.warn{background:var(--warn);box-shadow:0 0 10px rgba(255,176,32,.8)}
.led.fail{background:var(--red);box-shadow:0 0 10px rgba(255,92,92,.8)}
.led.info{background:#5ea2ff;box-shadow:0 0 10px rgba(94,162,255,.6)}
@keyframes pulse{50%{opacity:.55}}
.badge{font-size:11.5px;padding:2px 9px;border-radius:999px;border:1px solid var(--line);color:var(--dim);white-space:nowrap}
.badge.gold{color:var(--gold);border-color:rgba(245,197,66,.4);background:rgba(245,197,66,.08)}
.badge.ok{color:var(--ok);border-color:rgba(61,220,132,.35);background:rgba(61,220,132,.07)}
.badge.warn{color:var(--warn);border-color:rgba(255,176,32,.35);background:rgba(255,176,32,.07)}
.badge.red{color:#ffb3b3;border-color:rgba(255,92,92,.35);background:rgba(255,92,92,.07)}
table{width:100%;border-collapse:collapse;font-size:13px}
th,td{text-align:left;padding:7px 10px;border-bottom:1px solid var(--line);vertical-align:top}
th{color:var(--dim);font-weight:600;font-size:12px;text-transform:uppercase;letter-spacing:.4px}
tr:last-child td{border-bottom:none}
code,.mono{font-family:Consolas,"Cascadia Mono",monospace;font-size:12.5px;color:#cfe3ff}
.muted{color:var(--dim)}
.small{font-size:12px}
.xs{font-size:11.5px}
input[type=text],textarea,select{
  background:rgba(0,0,0,.35);border:1px solid var(--line);color:var(--text);border-radius:9px;
  padding:7px 10px;font:inherit;font-size:13px;outline:none;width:100%;
}
input[type=text]:focus,textarea:focus,select:focus{border-color:rgba(245,197,66,.5);box-shadow:0 0 0 3px rgba(245,197,66,.12)}
textarea{font-family:Consolas,"Cascadia Mono",monospace;font-size:12.5px;min-height:120px;resize:vertical}
label.chk{display:flex;gap:8px;align-items:center;font-size:13px;color:var(--dim);cursor:pointer;user-select:none}
input[type=checkbox]{accent-color:var(--gold);width:15px;height:15px}
.switch{position:relative;width:42px;height:23px;flex:none;cursor:pointer}
.switch input{display:none}
.switch i{
  position:absolute;inset:0;border-radius:999px;background:rgba(255,255,255,.12);
  transition:.18s;border:1px solid var(--line);
}
.switch i::after{
  content:"";position:absolute;top:2px;left:2px;width:17px;height:17px;border-radius:50%;
  background:#cfd6e4;transition:.18s;
}
.switch input:checked+i{background:linear-gradient(135deg,var(--gold),#ffdf7e);border-color:transparent}
.switch input:checked+i::after{left:21px;background:#17120a}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.ms-other{opacity:.55}
.chip{
  display:inline-flex;gap:6px;align-items:center;padding:3px 6px 3px 10px;border-radius:999px;
  border:1px solid var(--line);background:var(--panel2);font-size:12px;color:var(--dim);
}
.chip b{color:var(--text);font-weight:500}
.chip button{all:unset;cursor:pointer;width:16px;height:16px;border-radius:50%;display:grid;place-items:center;color:var(--dim);font-size:11px}
.chip button:hover{background:rgba(255,92,92,.2);color:#ffb3b3}
.hair{height:1px;background:var(--line);margin:10px 0;border:0}
#toasts{position:fixed;right:18px;bottom:18px;display:flex;flex-direction:column;gap:8px;z-index:50;max-width:400px}
.toast{
  padding:10px 14px;border-radius:11px;font-size:13px;border:1px solid var(--line);
  background:rgba(18,22,30,.95);box-shadow:0 14px 40px -18px rgba(0,0,0,.9);
  animation:fade .2s ease;white-space:pre-wrap;
}
.toast.err{border-color:rgba(255,92,92,.5);color:#ffc9c9}
.toast.ok{border-color:rgba(61,220,132,.4)}
.verify-list{display:flex;flex-direction:column;gap:2px}
.vrow{display:flex;gap:10px;padding:6px 4px;border-bottom:1px solid rgba(255,255,255,.04);align-items:flex-start}
.vrow:last-child{border-bottom:0}
.vrow .led{margin-top:6px}
.help{font-size:12px;color:var(--dim);background:rgba(94,162,255,.06);border:1px solid rgba(94,162,255,.18);border-radius:10px;padding:8px 12px}
.warnbox{font-size:12px;color:#ffd9a1;background:rgba(255,176,32,.07);border:1px solid rgba(255,176,32,.25);border-radius:10px;padding:8px 12px}
.flex{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.grow{flex:1;min-width:120px}
.section-title{font-size:14px;font-weight:600;margin:8px 0 2px;letter-spacing:.2px}
details{border:1px solid var(--line);border-radius:10px;padding:8px 12px;background:var(--panel)}
summary{cursor:pointer;color:var(--dim);font-size:13px}

/* ---------- ตั้งค่า OpenCode (tui-settings) — scoped under .settings ---------- */
.settings{display:flex;flex-direction:column;gap:12px}
.settings-bar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;position:sticky;top:0;z-index:5;padding:10px 12px;border:1px solid var(--line);border-radius:12px;background:linear-gradient(180deg,rgba(18,22,30,.96),rgba(18,22,30,.82));backdrop-filter:blur(8px)}
.settings-bar .search{flex:1;min-width:200px}
.settings .group{border:1px solid var(--line);border-radius:12px;background:var(--panel);padding:10px 14px}
.settings .group>header h2{font-size:13px;margin:0;color:var(--text);font-weight:600;letter-spacing:.3px;display:flex;gap:8px;align-items:baseline}
.settings .group>header p{margin:4px 0 0;font-size:11.5px;color:var(--dim)}
.settings .subgroup{margin-top:8px;padding:6px 10px}
.settings .subgroup>summary{font-size:12.5px}
.settings .rows{display:flex;flex-direction:column;gap:2px;margin-top:6px}
.settings .row{display:flex;align-items:flex-start;gap:10px;padding:7px 4px 7px 8px;border-bottom:1px solid rgba(255,255,255,.04);border-left:2px solid transparent}
.settings .row:last-child{border-bottom:0}
.settings .row:hover{background:rgba(255,255,255,.02)}
.settings .row.edited{border-left-color:var(--gold);background:rgba(245,197,66,.05)}
.settings .row .rowhead{flex:1;min-width:0;display:flex;gap:12px;align-items:flex-start;justify-content:space-between}
.settings .row .label{font-size:13px;color:var(--text)}
.settings .row .path{font-size:11.5px;color:#cfe3ff;background:rgba(0,0,0,.3);border:1px solid var(--line);border-radius:6px;padding:1px 6px;margin-left:6px}
.settings .row .card .sub,.settings .row .muted.small{margin-top:2px}
.settings .badges{display:flex;gap:6px;flex-wrap:wrap;margin-top:4px}
.settings .badge.def{color:var(--gold);border-color:rgba(245,197,66,.35);background:rgba(245,197,66,.07)}
.settings .badge.none{color:var(--dim2)}
.settings .badge.src{color:#9fd0ff;border-color:rgba(94,162,255,.3);background:rgba(94,162,255,.06)}
.settings .badge.opt{color:var(--dim2)}
.settings .ctl{flex:none;min-width:220px;display:flex;gap:8px;align-items:center;justify-content:flex-end;flex-wrap:wrap}
.settings .ctl input[type=text],.settings .ctl input[type=number],.settings .ctl select,.settings .ctl .search{width:auto;min-width:150px}
.settings .clr{all:unset;cursor:pointer;flex:none;width:22px;height:22px;border-radius:7px;display:grid;place-items:center;color:var(--dim2);font-size:14px;border:1px solid var(--line)}
.settings .clr:hover{background:rgba(255,92,92,.18);color:#ffb3b3}
.settings .switch{position:relative;width:42px;height:23px;flex:none;cursor:pointer;display:inline-block}
.settings .switch input{display:none}
.settings .switch .track{position:absolute;inset:0;border-radius:999px;background:rgba(255,255,255,.12);transition:.18s;border:1px solid var(--line)}
.settings .switch .track::after{content:"";position:absolute;top:2px;left:2px;width:17px;height:17px;border-radius:50%;background:#cfd6e4;transition:.18s}
.settings .switch input:checked+.track{background:linear-gradient(135deg,var(--gold),#ffdf7e);border-color:transparent}
.settings .switch input:checked+.track::after{left:21px;background:#17120a}
.settings fieldset.nested{border:1px dashed var(--line);border-radius:10px;margin:0;padding:4px 10px 8px}
.settings .kb{display:flex;gap:8px;align-items:flex-start;flex-wrap:wrap;justify-content:flex-end}
.settings .kb .kb-mode{min-width:130px;width:auto}
.settings .kb-capture{display:inline-flex}
.settings .hint{font-size:11.5px;color:var(--dim);margin-top:6px}
.settings .warnbox{margin-top:6px}
.settings .boolmap,.settings .list{display:flex;flex-direction:column;gap:6px}
.settings .bm-row,.settings .li-row,.settings .row-inline{display:flex;gap:8px;align-items:center}
.settings .bm-row input,.settings .li-row input{flex:1}
.settings .union{display:flex;gap:8px;align-items:center;flex-wrap:wrap;justify-content:flex-end}
.settings .readonly .ctl code{color:var(--dim)}
</style>
</head>
<body>
<div class="app">
  <aside>
    <div class="brand">
      <div class="logo">⬢</div>
      <div><b>BAZER</b><i>Console</i></div>
    </div>
    <nav id="nav">
      <button data-tab="dash" class="on">ภาพรวม</button>
      <button data-tab="lock">ล็อก &amp; โมเดล</button>
      <button data-tab="server">Server &amp; Cline</button>
      <button data-tab="pstack">pStack</button>
      <div class="navgroup">โหมดผู้ช่วย <span id="navModesCnt" class="cnt"></span></div>
      <span id="navModes"></span>
      <div class="navgroup">Subagent <span id="navSubCnt" class="cnt"></span></div>
      <span id="navSub"></span>
      <button data-tab="projects">โปรเจกต์</button>
      <button data-tab="plannotator">Plannotator</button>
      <button data-tab="tui">ตั้งค่า OpenCode</button>
      <button data-tab="history">ประวัติ &amp; สำรอง</button>
    </nav>
    <div class="foot">
      <div class="pill"><span class="led" id="serverLed"></span><span id="serverPillText">กำลังโหลด…</span></div>
      <button class="btn gold" data-act="verify">⚡ ตรวจความครบ</button>
    </div>
  </aside>
  <main>
    <header>
      <h1 id="hTitle">ภาพรวม</h1>
      <div class="hacts">
        <button class="btn ghost" data-act="refresh">↻ รีเฟรช</button>
      </div>
    </header>
    <div id="view" class="view"></div>
  </main>
</div>
<div id="toasts"></div>
<script>
const TOKEN = new URLSearchParams(location.search).get('t') || '';
let TAB = (()=>{ try { let t = localStorage.getItem('bazerTab') || 'dash'; if(t === 'agent:arena.md') t = 'arena'; if(t === 'agent:buddha.md') t = 'buddha'; return t; } catch { return 'dash'; } })(), S = null, VERIFY = null, MODELS = null, BP = null, FILTER = '', MS = null, AMODELS = null, SETUP = null, UP = null, ROLES = null, TUI = null, TUI_STATE = null;

async function api(u, opts={}){
  const r = await fetch(u, {
    method: opts.post ? 'POST' : 'GET',
    headers: { 'x-oc-token': TOKEN, ...(opts.post ? {'content-type':'application/json'} : {}) },
    body: opts.post ? JSON.stringify(opts.post) : undefined,
  });
  if(!r.ok){ let t=''; try{ t = await r.text(); }catch{} throw new Error(t.slice(0,300) || ('HTTP '+r.status)); }
  return r.json();
}

function toast(msg, isErr){
  const d = document.createElement('div');
  d.className = 'toast ' + (isErr ? 'err' : 'ok');
  d.textContent = msg;
  document.getElementById('toasts').appendChild(d);
  setTimeout(()=>{ d.style.opacity='0'; d.style.transition='opacity .3s'; setTimeout(()=>d.remove(), 320); }, isErr ? 7000 : 3500);
}
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const led = l => `<span class="led ${l}"></span>`;
const MODE_LABEL = {
  'deepseek-only': ['ล็อกแน่น — deepseek ตัวเดียว', 'ok'],
  'provider-only': ['ล็อก provider เดียว (opencode-go)', 'ok'],
  'off': ['ปลดล็อก (ไฟล์ว่าง)', 'warn'],
  'custom': ['กำหนดเอง', 'info'],
  'none': ['ยังไม่มีไฟล์ล็อก', 'fail'],
};

async function refresh(){
  try{
    S = await api('/api/state');
    render();
  }catch(e){ toast('โหลดสถานะไม่สำเร็จ: ' + e.message, true); }
}

async function act(id, params={}, confirmText){
  if(confirmText && !confirm(confirmText)) return;
  try{
    const r = await api('/api/action', { post: { id, ...params } });
    if(r.ok === false){
      const stale = /ไม่รู้จัก action/.test(String(r.message||''));
      toast(stale ? 'แอปที่เปิดอยู่ยังเป็นโค้ดเก่า — ปิด-เปิด BAZER Console ใหม่แล้วกดอีกครั้ง' : 'ผิดพลาด: ' + (r.message||''), true);
    }
    else { toast(r.message || 'สำเร็จ'); }
    await refresh();
    const after = ['set-lock','update-blacklist','set-model-effort','save-text','build-apply','skill-hide','skill-show','skill-remove-field','agent-toggle','agent-del','command-toggle','plannotator-toggle','restore-backup','save-pstack-models','save-plannotator-config','save-plannotator-prefs','scan-projects','project-agent-toggle','project-agent-del','project-agent-add','project-init','setup-apply','update-apply','sync-all','refresh-config','reset-template','save-agent','pm-role-save','pm-legacy-migrate','pm-legacy-del','mirror-agents','install-agent','flow-apply','flow-toggle','set-mode-lock','check-mode-lock','migrate-tui','tui-save','tui-reset','tui-import','tui-refresh'];
    if(after.includes(id)) runVerify(false);
  }catch(e){ toast('ผิดพลาด: ' + e.message, true); }
}

async function runVerify(showTab){
  try{
    VERIFY = await api('/api/verify');
    if(showTab !== false) tab('dash'); else render();
  }catch(e){ toast('ตรวจไม่สำเร็จ: ' + e.message, true); }
}

function anyDirty(){ return [...document.querySelectorAll('textarea')].some(t => t.dataset.dirty === '1'); }
function setVerifyBadge(){
  const b = document.querySelector('.foot [data-act="verify"]');
  if(!b) return;
  if(!VERIFY){ b.textContent = '⚡ ตรวจความครบ'; b.className = 'btn gold'; return; }
  const s = VERIFY.summary || {};
  const parts = [];
  if(s.fail) parts.push('✕ ' + s.fail);
  if(s.warn) parts.push('⚠ ' + s.warn);
  b.textContent = '⚡ ตรวจความครบ' + (parts.length ? ' · ' + parts.join(' · ') : ' · ผ่านหมด');
  b.className = 'btn ' + (s.fail ? 'danger' : (s.warn ? '' : 'gold'));
}

function tab(name){
  TAB = name;
  try{ localStorage.setItem('bazerTab', name); }catch{}
  document.querySelectorAll('#nav button').forEach(b => b.classList.toggle('on', b.dataset.tab === name));
  render();
}

