const ROLE_LIST = [
  'feature, refactoring', 'bug-fix', 'perf-issue', 'hillclimb',
  'judgment and prose', 'hardest tasks',
  'how explorer', 'how explainer', 'why investigators', 'why synthesizer',
  'reflect tooling', 'reflect judgment, divergent, synthesizer',
  'arena runners', 'arena cross-judge pool',
  'swarm workers', 'architect runners', 'interrogate reviewers',
];
const QUICK_MODELS = [
  'opencode-go/deepseek-v4.1-flash',
  'opencode-go/beam-free',
  'opencode-go/muse-spark-1.3-contributor',
  'opencode-go/longcat-2.5-preview-free',
];
const ROLE_RE = /^[a-z][a-z0-9, -]*$/;
function initMS(){
  const txt = (S.models2 && S.models2.content) || '';
  const custom = {}; const extra = []; let budget = 'large';
  for(const line of txt.split(/\r?\n/)){
    const l = line.trim();
    if(!l) continue;
    if(l.startsWith('#')){ const b = l.match(/^#\s*budget:\s*(\w+)/); if(b && ['unlimited','large','medium','small'].includes(b[1])) budget = b[1]; continue; }
    const i = l.indexOf(':');
    if(i <= 0) continue;
    const role = l.slice(0, i).trim();
    const models = l.slice(i + 1).trim();
    if(!role || role.length > 60 || !ROLE_RE.test(role)) continue;
    custom[role] = models;
    if(!ROLE_LIST.includes(role) && !extra.includes(role)) extra.push(role);
  }
  const sets = (S.modelSets || []).map(s => ({
    name: String(s.name || 'ชุดใหม่'),
    models: Array.isArray(s.models) ? s.models.slice() : [],
    roles: Array.isArray(s.roles) ? s.roles.filter(r => r).slice() : [],
  }));
  MS = { budget, sets, custom, extraRoles: extra };
  for(const s of sets) for(const r of s.roles) if(s.models.length) MS.custom[r] = s.models.join(', ');
}
function ownerOf(role){ return MS.sets.find(s => s.roles.includes(role)) || null; }
function allRoleNames(){
  const owned = MS.sets.flatMap(s => s.roles);
  return [...new Set([...ROLE_LIST, ...(MS.extraRoles || []), ...owned])];
}
function quickBtns(target, present){
  const arr = present || [];
  return QUICK_MODELS.map(m => {
    const short = m.split('/').pop();
    if(arr.includes(m)) return `<button class="btn sm" disabled title="${esc(m)} — มีอยู่แล้ว">✓ ${esc(short)}</button>`;
    return `<button class="btn sm ghost" data-act="ms-quick" data-t="${esc(target)}" data-model="${esc(m)}" title="${esc(m)}">⚡ ${esc(short)}</button>`;
  }).join(' ');
}
