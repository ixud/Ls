function parseRoles(){
  const txt = (S.models2 && S.models2.content) || '';
  const out = { 'arena runners': [], 'arena cross-judge pool': [] };
  for(const line of txt.split(/\r?\n/)){
    const i = line.indexOf(':');
    if(i < 0) continue;
    const r = line.slice(0, i).trim();
    if(out[r]) out[r] = line.slice(i + 1).split(',').map(s => s.trim()).filter(Boolean);
  }
  ROLES = out;
}
