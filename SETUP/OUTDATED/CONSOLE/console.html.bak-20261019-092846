function mountTui(){
  const host = document.getElementById('tuiHost');
  if(!host || !TUI || typeof TUIWidget === 'undefined') return;
  TUI_STATE = TUIWidget.createState(TUI.model, TUI.files?.cli?.values || {});
  host.innerHTML = '<div id="tuiInner"></div>';
  const inner = document.getElementById('tuiInner');
  const paint = () => { inner.innerHTML = TUIWidget.renderSettings(TUI_STATE); };
  const syncBar = () => {
    const n = TUIWidget.dirtyCount(TUI_STATE);
    const d = host.querySelector('[data-role="dirty"]'); if(d) d.textContent = n + ' ค่าที่แก้ไว้';
    const sb = host.querySelector('[data-role="save"]'); if(sb) sb.disabled = !n;
    const rb = host.querySelector('[data-role="revert"]'); if(rb) rb.disabled = !n;
  };
  paint();
  TUIWidget.bindSettings(host, TUI_STATE, { onChange: () => {
    syncBar();
    const ae = document.activeElement;
    const ctl = ae && ae.dataset ? ae.dataset.ctl : '';
    if(ctl === 'search'){
      const caret = ae.selectionStart;
      paint();
      const si = inner.querySelector('[data-ctl="search"]');
      if(si){ si.focus(); try{ si.setSelectionRange(caret, caret); }catch{} }
    } else if(['text','number','kb-keys','kb-json','li','li-json','bm-key'].includes(ctl)){
      /* free-text: ช่องสะท้อนค่าเองแล้ว ไม่วาดใหม่เพื่อไม่ให้เสียโฟกัส */
    } else {
      paint();
    }
  } });
  host.addEventListener('click', e => {
    const role = e.target.closest('[data-role]')?.dataset.role;
    if(role === 'save'){
      const patches = TUIWidget.collectPatches(TUI_STATE);
