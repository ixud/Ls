      else {
        if(cur){ cur.roles = cur.roles.filter(r => r !== role); toast(`ย้าย "${role}" จากชุด "${cur.name}" → "${s.name}"`); }
        s.roles.push(role);
        if(s.models.length) MS.custom[role] = s.models.join(', ');
      }
      renderMS(); saveSets();
      break;
    }
    case 'ms-make-set': {
      if(!MS) initMS();
      collectMS();
      const role = t.dataset.role;
      const val = (MS.custom[role] || '').split(',').map(x => x.trim()).filter(Boolean);
      const nm = prompt('ตั้งชื่อชุดใหม่สำหรับ "' + role + '":', role.slice(0, 24));
      if(nm === null) break;
      const cur = ownerOf(role); if(cur) cur.roles = cur.roles.filter(r => r !== role);
      MS.sets.push({ name: (nm.trim() || role.slice(0, 24)), models: val, roles: [role] });
      renderMS(); saveSets();
      break;
    }
    case 'ms-reset': { MS = null; ROLES = null; if(TAB === 'pstack'){ initMS(); renderMS(); } break; }
    case 'ms-save': {
      if(!MS) initMS();
      collectMS();
      const rows = []; const seen = new Set();
      for(const s of MS.sets){
        for(const r of s.roles){
          if(seen.has(r)) continue;
          seen.add(r);
          if(s.models.length) rows.push({ role: r, models: s.models.join(', ') });
        }
      }
      for(const r of allRoleNames()){
        if(seen.has(r)) continue;
        seen.add(r);
        const v = (MS.custom[r] || '').trim();
        if(v) rows.push({ role: r, models: v });
      }
      for(const s of MS.sets) for(const r of s.roles){ if(s.models.length) MS.custom[r] = s.models.join(', '); }
      act('save-pstack-models', { budget: MS.budget, rows });
      break;
    }
    case 'amodels-fetch': {
      try{ const r = await api('/api/action', { post: { id:'list-avail-models' } }); AMODELS = r.models || []; toast(r.message || ('ได้ ' + AMODELS.length + ' โมเดล')); render(); }
      catch(err){ toast('ดึงรายชื่อไม่สำเร็จ: ' + err.message, true); }
      break;
    }
    case 'pj-scan': {
      try{ const r = await api('/api/action', { post: { id:'scan-projects' } }); toast(r.message || 'สแกนเสร็จ'); await refresh(); }
      catch(err){ toast('สแกนไม่สำเร็จ: ' + err.message, true); }
      break;
    }
    case 'pj-toggle': act('project-agent-toggle', { file: t.dataset.file, enable: t.dataset.en === '1' }, 'สลับสถานะ agent ในโปรเจกต์นี้?'); break;
    case 'pj-del': act('project-agent-del', { file: t.dataset.file }, 'ลบ agent ในโปรเจกต์นี้? (สำรองไว้ — กู้ได้ในแท็บประวัติ)'); break;
    case 'pj-add': {
      const sel = t.closest('.flex')?.querySelector('.pj-add');
      if(sel && sel.value) act('project-agent-add', { root: t.dataset.root, name: sel.value });
      break;
    }
    case 'pj-init': act('project-init', { root: t.dataset.root }, 'ติดตั้ง .opencode เริ่มต้น (agents ชุด pStack + AGENTS.md + opencode.json) ในโปรเจกต์นี้?'); break;
    case 'setup-preview': {
      try{ SETUP = await api('/api/action', { post: { id:'setup-preview' } }); renderSetupBox(); }
      catch(err){ toast('พรีวิวไม่สำเร็จ: ' + err.message, true); }
      break;
    }
    case 'setup-quick': {
      try{
        const pv = await api('/api/action', { post: { id:'setup-preview' } });
        const steps = pv.steps.filter(s => s.will).map(s => s.id);
        if(!steps.length){ toast('ทุกอย่างตั้งไว้ครบแล้ว — ไม่มีอะไรต้องติดตั้ง'); break; }
        if(!confirm('ติดตั้ง ' + steps.length + ' ขั้นตอน: ' + steps.join(', ') + ' ?')) break;
        const r = await api('/api/action', { post: { id:'setup-apply', steps } });
        toast(r.message || 'ติดตั้งเสร็จ'); await refresh(); runVerify(false);
      }catch(err){ toast('ติดตั้งไม่สำเร็จ: ' + err.message, true); }
      break;
    }
    case 'setup-run': {
      const steps = [...document.querySelectorAll('.su-step:checked')].map(x => x.dataset.id);
      if(!steps.length){ toast('ยังไม่ได้เลือกขั้นตอน'); break; }
      act('setup-apply', { steps, overwrite: document.getElementById('suOverwrite')?.checked || false, autostart: document.getElementById('suAutostart')?.checked || false }, 'ติดตั้ง ' + steps.length + ' ขั้นตอนที่เลือก?');
      break;
    }
    case 'update-check': {
      try{ UP = await api('/api/action', { post: { id:'update-check' } }); toast(UP.message || 'ตรวจแล้ว'); render(); }
      catch(err){ toast('ตรวจไม่สำเร็จ: ' + err.message, true); }
      break;
    }
    case 'update-run': {
      if(!UP){
        try{ UP = await api('/api/action', { post: { id:'update-check' } }); }catch(err){ toast('ตรวจไม่สำเร็จ: ' + err.message, true); break; }
        if(!UP.counts || (!UP.counts.new && !UP.counts.diff)){ toast('ทุกอย่างเป็นเวอร์ชันล่าสุดอยู่แล้ว'); render(); break; }
      }
      UP = null;
      act('update-apply', {}, 'อัพเดตทับไฟล์ที่ต่าง/ใหม่ทั้งหมด? (สำรองอัตโนมัติก่อนทุกไฟล์)');
      break;
    }
    case 'sync-all': {
      act('sync-all', {}, 'ซิงค์ทั้งหมด: อัพเดตจาก bundle + ปรับ planningAgents + อัพเดต mirror แล้วตรวจความครบ?');
      break;
    }
    case 'reset-template': {
      act('reset-template', { name: t.dataset.name }, 'เขียนทับ ' + t.dataset.name + ' ด้วยค่าเริ่มต้นจาก bundle? (สำรองของเดิมก่อน)');
      break;
    }
    case 'agent-save': {
      const ta = t.closest('details')?.querySelector('.agent-edit') || (t.closest('.card')?.querySelector('.agent-edit'));
      if(!ta){ toast('ไม่พบช่องแก้ไข', true); break; }
      act('save-agent', { file: ta.dataset.file, content: ta.value });
      break;
    }
    case 'role-add': {
      if(!ROLES) parseRoles();
      const role = t.dataset.role;
      const inp = document.querySelector(`.role-add[data-role="${role}"]`);
      const v = (inp?.value || '').trim();
      if(v && ROLES[role] && !ROLES[role].includes(v)){ ROLES[role].push(v); if(inp) inp.value = ''; }
      renderRoleChips();
      break;
    }
    case 'role-del': {
      if(!ROLES) parseRoles();
      const role = t.dataset.role;
      if(ROLES[role]) ROLES[role].splice(+t.dataset.j, 1);
      renderRoleChips();
      break;
    }
    case 'role-save': {
      if(!ROLES) parseRoles();
      const role = t.dataset.role;
      const inp = document.querySelector(`.role-add[data-role="${role}"]`);
      const v = (inp?.value || '').trim();
      if(v && ROLES[role] && !ROLES[role].includes(v)){ ROLES[role].push(v); if(inp) inp.value = ''; }
      act('pm-role-save', { role, models: ROLES[role] || [] });
      break;
    }
    case 'roles-reset': { ROLES = null; parseRoles(); renderRoleChips(); toast('โหลดค่าจากไฟล์ใหม่แล้ว'); break; }
    case 'legacy-migrate': act('pm-legacy-migrate', {}, 'ย้ายค่า bazer arena runners ไป arena runners?'); break;
    case 'legacy-del': act('pm-legacy-del', {}, 'ลบบรรทัดเก่า bazer arena runners?'); break;
    case 'mirror-run': act('mirror-agents', {}, 'อัพเดต mirror โหมด → skills (สำรองก่อนเขียนทุกไฟล์)?'); break;
    case 'flow-apply': act('flow-apply', {}, 'ติดตั้ง/ซ่อม BAZER FLOW v2 (plugin + builder + กฎ AGENTS.md)?'); break;
    case 'flow-toggle': act('flow-toggle', { enable: t.dataset.en === '1' }, 'สลับการติดตั้ง BAZER FLOW v2?'); break;
    case 'install-agent': act('install-agent', { file: t.dataset.file }, `ติดตั้ง ${t.dataset.file} จาก bundle เข้าเครื่อง?`); break;
    case 'copy-bazer': {
      try{ await navigator.clipboard.writeText('opencode run --agent bazer "โจทย์ของคุณ"'); toast('คัดลอกแล้ว — หรือกด Tab เลือก Bazer ใน TUI'); }
      catch{ toast('คัดลอกไม่สำเร็จ', true); }
      break;
    }
    case 'copy-snack': {
      try{ await navigator.clipboard.writeText('opencode run --agent snack "โจทย์ของคุณ"'); toast('คัดลอกแล้ว — หรือกด Tab เลือก Snack ใน TUI'); }
      catch{ toast('คัดลอกไม่สำเร็จ', true); }
      break;
    }
    case 'pl-cfg-save': act('save-plannotator-config', { semanticDiff: document.getElementById('plSemantic').checked, callFlow: document.getElementById('plCallFlow').checked }); break;
    case 'pl-cfg-raw-save': act('save-plannotator-config', { raw: document.getElementById('plCfgRaw').value }); break;
    case 'pl-prefs-save': act('save-plannotator-prefs', { content: document.getElementById('plPrefs').value }); break;
    case 'npx-list': act('npx-skills', { op:'list' }); break;
    case 'npx-update': act('npx-skills', { op:'update' }, 'รัน npx skills update -g? (อาจใช้เวลาหลายนาที)'); break;
    case 'agent-toggle': act('agent-toggle', { file: t.dataset.file, enable: t.dataset.en === '1' }, 'สลับสถานะ agent นี้?'); break;
    case 'agent-del': act('agent-del', { file: t.dataset.file }, `ลบ ${t.dataset.file}? (สำรองไว้ก่อน)`); break;
    case 'cmd-toggle': act('command-toggle', { file: t.dataset.file, enable: t.dataset.en === '1' }, 'สลับสถานะคำสั่งนี้?'); break;
    case 'pl-toggle': act('plannotator-toggle', { enable: t.checked }, 'สลับปลั๊กอิน Plannotator ใน global config?'); break;
    case 'pl-clear': act('plannotator', { op:'clear-cache' }, 'ล้าง cache ปลั๊กอิน? (OpenCode จะติดตั้งใหม่ตอนเปิดครั้งถัดไป)'); break;
    case 'pl-version': act('plannotator', { op:'version' }); break;
    case 'open': { try{ await api('/api/action', { post: { id:'open-folder', key: t.dataset.key } }); }catch(err){ toast(err.message, true); } break; }
    case 'bk-restore': act('restore-backup', { set: t.dataset.set }, `กู้คืนชุดสำรอง ${t.dataset.set}?\nไฟล์ปัจจุบันจะถูกสำรองก่อนเขียนทับ`); break;
    default: break;
  }
});

refresh();
setInterval(() => { if(!document.hidden) refreshQuiet(); }, 30000);
async function refreshQuiet(){ if(anyDirty()) return; const ae = document.activeElement; if(ae && ['TEXTAREA','INPUT','SELECT'].includes(ae.tagName)) return; try{ S = await api('/api/state'); render(); }catch{} }
</script>
</body>
</html>
