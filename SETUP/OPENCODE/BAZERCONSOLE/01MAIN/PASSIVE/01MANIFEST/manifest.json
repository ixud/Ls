    {
      "id": "launch.windows",
      "kind": "launcher",
      "title": "ตัวเปิด Console (Windows)",
      "source": "BAZERCONSOLE/03WINDOWS/BAZER CONSOLE.vbs",
      "target": "${LAUNCH}/bazer-console.vbs",
      "strategy": "create-only",
      "platform": "win32",
      "status": "design",
      "auto": false,
      "why": "ตัวเปิดต้องอยู่ติดกับ MAJOR เพื่อหา server เจอ — การติดตั้งไปที่อื่นจะทำให้ path เพี้ยน ใช้ 03WINDOWS/BAZER CONSOLE.vbs โดยตรง หรือรัน 02SHORTCUT/create-desktop-shortcut.ps1"
    },
    {
      "id": "plugin.bazer-flow",
      "kind": "plugin",
      "title": "ปลั๊กอิน gate bazer-flow (ต้นทางใน MAJOR)",
      "source": "AGENT/04PLUGIN/bazer-flow",
      "target": "${CONFIG}/plugins/bazer-flow",
      "strategy": "copy-tree",
      "prune": true,
      "owner": "ours",
      "status": "ready",
      "auto": false,
      "proof": "plugin-registered",
      "why": "auto=false โดยเจตนา: การเปิด gate เป็นการเปลี่ยนพฤติกรรมทั้งระบบ ต้องกดเอง. prune=true = ไฟล์รุ่นเก่าที่ไม่มีในต้นทางถูกย้ายเข้า backup (ไม่ลบทิ้ง)"
    },
    {
      "id": "plugin.bazer-fire",
      "kind": "plugin",
      "title": "ปลั๊กอิน badge บน TUI",
      "target": "${CONFIG}/plugins/bazer-fire",
      "strategy": "copy-tree",
      "status": "design",
      "auto": false,
      "why": "badge บน TUI เป็นของประดับ ไม่กระทบความถูกต้องของงาน — ยังไม่เขียนจนกว่าจะมี probe ที่พิสูจน์ว่าผู้ใช้ต้องการ; ข้อมูลสถานะมีอยู่ที่หน้า Console แล้ว"
    }
