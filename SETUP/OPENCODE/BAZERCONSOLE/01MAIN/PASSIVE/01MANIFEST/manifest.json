{
  "schemaVersion": 1,
  "note": "ที่อยู่ปลายทางทั้งหมดอยู่ในไฟล์นี้ที่เดียว — ACTIVE/** ห้าม hardcode (R2)",
  "entries": [
    {
      "id": "cfg.builtin-off",
      "kind": "config",
      "title": "ซ่อน Plan/Build/Poteto Mode (เหลือโหมดหลัก 4 ตัว)",
      "target": "${CONFIG}/opencode.jsonc",
      "strategy": "jsonc-merge",
      "valuePath": "agent",
      "value": {
        "plan": { "mode": "subagent", "hidden": true },
        "build": { "mode": "subagent", "hidden": true },
        "poteto-mode": { "mode": "subagent", "hidden": true }
      },
      "status": "ready",
      "auto": true,
      "proof": "builtin-hidden",
      "why": "ผู้ใช้ต้องการเหลือโหมดของเรา 4 ตัวใน Shift+Tab — ซ่อน plan/build/poteto-mode จาก config ไม่ลบไฟล์ จึงย้อนกลับได้"
    },
    {
      "id": "cfg.buddha-default",
      "kind": "config",
      "title": "ระดับความแรงเริ่มต้นของ BUDDHA (ขั้น 1 สุภาพ)",
      "target": "${CONFIG}/opencode.jsonc",
      "strategy": "jsonc-merge",
      "valuePath": "agent.buddha.permission",
      "fromPolicy": "buddha-ladder",
      "onlyIfMissing": true,
      "status": "ready",
      "auto": true,
      "why": "ถ้าผู้ใช้เคยกดบันไดไว้แล้ว ห้ามทับด้วยค่า default ตอนอัพเดต"
    },
    {
      "id": "cfg.bazer-default",
      "kind": "config",
      "title": "ระดับความแรงเริ่มต้นของ BAZER (ขั้น 1 สุภาพ)",
      "target": "${CONFIG}/opencode.jsonc",
      "strategy": "jsonc-merge",
      "valuePath": "agent.bazer.permission",
      "fromPolicy": "bazer-ladder",
      "onlyIfMissing": true,
      "status": "ready",
      "auto": true,
      "why": "บันไดของ BAZER แยกจาก BUDDHA — ถ้าผู้ใช้เคยกดบันไดไว้แล้ว ห้ามทับด้วยค่า default"
    },
    {
      "id": "cfg.arena-runner-permission",
      "kind": "config",
      "title": "permission ของ ARENA-RUNNER (ตามบันได + ห้าม spawn)",
      "target": "${CONFIG}/opencode.jsonc",
      "strategy": "jsonc-merge",
      "valuePath": "agent.arena-runner.permission",
      "fromPolicy": "buddha-ladder",
      "policyOverrides": {
        "subagent": "deny",
        "external_directory": "allow"
      },
      "onlyIfMissing": true,
      "status": "ready",
      "auto": true,
      "why": "runner เขียน candidate ลง %TEMP% ของตัวเอง (ต้องมี external_directory) และห้ามเรียก subagent เพื่อไม่ให้แอบเรียกผู้แข่งคนอื่น"
    },
    {
      "id": "cfg.arena-judge-permission",
      "kind": "config",
      "title": "permission ของ ARENA-JUDGE (อ่านอย่างเดียว)",
      "target": "${CONFIG}/opencode.jsonc",
      "strategy": "jsonc-merge",
      "valuePath": "agent.arena-judge.permission",
      "fromPolicy": "buddha-ladder",
      "policyOverrides": {
        "edit": "deny",
        "shell": "deny",
        "subagent": "deny",
        "external_directory": "allow"
      },
      "onlyIfMissing": true,
      "status": "ready",
      "auto": true,
      "why": "กรรมการต้องอ่าน candidate ใน %TEMP% ได้ (external_directory) แต่ห้ามแก้ไฟล์ ห้ามรันคำสั่ง และห้ามเรียก subagent"
    },
    {
      "id": "cfg.keybinds",
      "kind": "config",
      "title": "คีย์ลัดเริ่มต้น (copy ข้อความล่าสุด)",
      "target": "${CONFIG}/tui.json",
      "strategy": "jsonc-merge",
      "valuePath": "keybinds.messages_copy",
      "value": ["ctrl+alt+m", "ctrl+alt+o"],
      "onlyIfMissing": true,
      "status": "ready",
      "auto": true
    },
