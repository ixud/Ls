[Desktop Entry]
Type=Application
Version=1.0
Name=BAZER CONSOLE - WINDOW (Linux)
Comment=BAZER Console — the Linux shortcut, counterpart of "BAZER CONSOLE - WINDOW (Windows).lnk"
# Self-locating: %k is this .desktop's own path, so it keeps working after the repo is
# cloned or moved. BAZER Console also rewrites this file with an absolute Exec the first
# time "สร้าง shortcut" / "ติดตั้งเสร็จสรรพ" runs, which is the most reliable form.
Exec=/bin/bash -c "k=\"%k\"; k=\"${k#file://}\"; exec /bin/bash \"$(dirname \"$k\")/CONSOLE/LINUX/BAZER Console.sh\""
Icon=utilities-terminal
Terminal=false
Categories=Development;
